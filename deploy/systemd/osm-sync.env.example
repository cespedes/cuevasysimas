# /opt/cuevasysimas/osm-sync.env — what cuevasysimas-osm-sync.service needs: the connection to the
# database (the same DATABASE_URL as api.env) and where the downloaded extracts are kept. A systemd
# EnvironmentFile (no shell syntax, no quotes). It holds the database password: readable by root and the
# service user only (mode 0640).
DATABASE_URL=postgres://cuevasysimas:CHANGE-ME@127.0.0.1:5432/cuevasysimas?sslmode=disable
# The same directory as StateDirectory in the unit.
OSM_CACHE_DIR=/var/lib/cuevasysimas-osm
# Only if osmium is not in the path of the service.
#OSMIUM_BIN=/usr/bin/osmium
