# /opt/cuevasysimas/api.env — the settings of cuevasysimas.service. A systemd EnvironmentFile (no shell
# syntax, no quotes). It holds the database password: readable by root and the service user only (0640).
HTTP_ADDR=127.0.0.1:64711
DATABASE_URL=postgres://cuevasysimas:CHANGE-ME@127.0.0.1:5432/cuevasysimas?sslmode=disable
# The photos and documents of the places: only through the API, and backed up with the database.
PLACE_FILES_ROOT=/opt/cuevasysimas/data/place-files
# The address of the public site and who answers for it (its legal notice and privacy policy say them).
# Until the three PUBLIC_SITE_LEGAL_* are given the pages say it is pending and ask search engines to stay out.
PUBLIC_SITE_URL=https://cuevasysimas.es
PUBLIC_SITE_LEGAL_NAME=
PUBLIC_SITE_LEGAL_ADDRESS=
PUBLIC_SITE_LEGAL_EMAIL=
# The instance that proposes the zone of a coordinate (the public one by default; its policy allows a request
# a second); "off" turns it off. Only the coordinate is sent.
#NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
# The project's own bot and channel, for notices of changes and errors. Leave both out to send nothing.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_LOG_CHAT_ID=
