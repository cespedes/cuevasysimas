# The site of the catalogue. Caddy looks after the HTTPS, may keep what the server marks as public
# (Cache-Control: public), and sends the address of the visitor as X-Forwarded-For (reverse_proxy does),
# which is what the limit of requests per address reads. The clients of the catalogue reach the API on this
# host too, with their assertion: nothing else is sent to the server.
cuevasysimas.es {
	encode zstd gzip
	@site path / /lugares/* /sitemap.xml /robots.txt /aviso-legal /privacidad /static/* /api/v1/*
	handle @site {
		reverse_proxy 127.0.0.1:64711
	}
	respond 404
}
